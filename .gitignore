# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# Supabase CLI temp files (contain project ref & org ID)
supabase/.temp/

# Claude Code (developer-specific — tooling, not application code)
.mcp.json
.claude/
.agents/
skills-lock.json

# dev-only market / pre-mainnet helpers (throwaway; connection details, testnet keys)
/.devmkt/
/scripts/devpsql.sh
/scripts/devmoney.mjs
/scripts/devgen-wallets.mjs
/scripts/devreconcile.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
